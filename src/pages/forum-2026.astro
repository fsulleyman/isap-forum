---
import Layout from '@/layouts/Layout.astro';
import PageBanner from '@/components/banners/PageBanner.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import { getForum2026Page, getEventFacts } from '@/lib/sanity/client';

const forum2026 = await getForum2026Page();
const eventFacts = await getEventFacts();
---

<Layout
  title={`${forum2026.bannerTitle} — The 2026 Edition`}
  description={forum2026.bannerSubtitle}
>
  <PageBanner
    title={forum2026.bannerTitle}
    subtitle={forum2026.bannerSubtitle}
    bannerImage={forum2026.bannerImage}
    badge="2026 Edition"
    breadcrumbs={[{ label: 'ISAP Forum 2026' }]}
  />

  <!-- Thematic Context Section -->
  <section class="py-16 md:py-20 bg-white border-b border-isap-border/30">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-isap-navy/5 text-isap-navy text-xs font-semibold uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-isap-gold"></span>
          <span>Thematic Focus</span>
        </div>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-heading text-isap-navy leading-tight">
          Public Sector Identification Systems for Socioeconomic Development
        </h2>

        <!-- Locked Theme Quote Box -->
        <div class="p-6 rounded-xl bg-isap-off-white border-l-4 border-isap-gold text-isap-navy font-medium text-lg leading-relaxed shadow-sm">
          "{eventFacts.theme}"
        </div>

        <!-- In-depth paragraphs -->
        <div class="space-y-4 text-base sm:text-lg text-isap-gray-dark leading-relaxed">
          {forum2026.aboutTheForum.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 7 Forum 2026 Specific Objectives -->
  <section class="py-16 md:py-24 bg-isap-off-white border-b border-isap-border/30">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <SectionHeading
        eyebrow="Deliverables & Outcomes"
        title={forum2026.objectivesHeading}
        description="Seven targeted inquiries and research objectives governing panel sessions, paper submissions, and policy communiqués."
        align="center"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
        {forum2026.objectives.map((obj) => (
          <div class="p-6 sm:p-7 rounded-xl bg-white border border-isap-border/70 shadow-sm hover:border-isap-gold/50 transition-colors flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="w-8 h-8 rounded-full bg-isap-navy text-white text-xs font-mono font-bold flex items-center justify-center">
                  0{obj.number}
                </span>
                <span class="text-[11px] font-semibold text-isap-steel uppercase tracking-wider">
                  Objective 0{obj.number}
                </span>
              </div>
              <h3 class="text-base sm:text-lg font-bold font-heading text-isap-navy leading-snug">
                {obj.title}
              </h3>
              <p class="text-xs sm:text-sm text-isap-gray-dark/85 leading-relaxed">
                {obj.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Event Summary & Registration Card -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="bg-isap-navy text-white rounded-2xl p-8 sm:p-12 shadow-xl border border-white/10 space-y-8">
        <div class="text-center space-y-2 max-w-2xl mx-auto">
          <span class="text-xs font-semibold text-isap-gold uppercase tracking-wider">Conference Fact Sheet</span>
          <h3 class="text-2xl sm:text-3xl font-bold font-heading text-white">
            Attend ISAP Forum 2026
          </h3>
          <p class="text-sm text-isap-steel">
            All academic presentations, keynotes, and panel deliberations will convene in person at UPSA.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-white/10 text-sm">
          <div class="space-y-1">
            <span class="text-xs text-isap-steel uppercase font-medium">Conference Date</span>
            <p class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-isap-gold"></span>
              <span>{eventFacts.date}</span>
            </p>
          </div>
          <div class="space-y-1">
            <span class="text-xs text-isap-steel uppercase font-medium">Conference Venue</span>
            <p class="text-base font-bold text-white">
              {eventFacts.venue}
            </p>
          </div>
          <div class="sm:col-span-2 space-y-1 pt-2 border-t border-white/10">
            <span class="text-xs text-isap-steel uppercase font-medium">Host Institution</span>
            <p class="text-xs sm:text-sm text-white/90">
              {eventFacts.hostInstitution}
            </p>
          </div>
        </div>

        <div class="pt-4 text-center">
          <a
            href="/register"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-md bg-isap-gold hover:bg-[#b88616] text-isap-navy-dark font-bold text-base shadow-lg transition-all"
          >
            <span>Proceed to Registration Portal</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
