---
import Layout from '@/layouts/Layout.astro';
import PageBanner from '@/components/banners/PageBanner.astro';
import NewsCard from '@/components/cards/NewsCard.astro';
import { getPublishedNews, getSiteSettings, lastQuerySources } from '@/lib/sanity/client';

const articles = await getPublishedNews();
const siteSettings = await getSiteSettings();
const isLive = lastQuerySources['publishedNews'] === 'live';
const dataSource = isLive ? 'Live Sanity Content Lake' : 'Fallback Fixtures';
console.log(`[/news render] Source: ${dataSource} | Found: ${articles.length} published news article(s) at ${new Date().toISOString()}`);
---

<Layout
  title="News & Updates — ISAP Forum"
  description="Official press releases, announcements, research calls, and editorial dispatches from the ISAP Forum Secretariat."
>
  <PageBanner
    title="News & Announcements"
    subtitle="Official Communications, Research Calls & Media Dispatches"
    bannerImage={siteSettings.newsBannerImage || siteSettings.bannerImage}
    badge="Secretariat Media"
    breadcrumbs={[{ label: 'News & Updates' }]}
  />

  <section class="py-16 md:py-24 bg-isap-off-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl space-y-10">
      
      {/* Dev-only verification badge */}
      {import.meta.env.DEV && (
        <div class={`p-3 border rounded-lg flex flex-wrap items-center justify-between gap-2 text-xs font-mono shadow-sm ${isLive ? 'bg-emerald-50 border-emerald-300 text-emerald-900' : 'bg-amber-50 border-amber-300 text-amber-900'}`} data-testid="data-source-badge">
          <div class="flex items-center gap-2">
            <span class={`w-2.5 h-2.5 rounded-full ${isLive ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500'}`}></span>
            <span>Data Source: <strong class="font-bold">{dataSource}</strong></span>
          </div>
          <span>Records: {articles.length} Published | Rendered: {new Date().toLocaleTimeString()}</span>
        </div>
      )}
      
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-isap-border/60">
        <div>
          <span class="text-xs font-bold text-isap-gold uppercase tracking-wider block mb-1">
            Editorial Feed
          </span>
          <h2 class="text-xl sm:text-2xl font-bold font-heading text-isap-navy">
            Published Announcements
          </h2>
        </div>
        <span class="text-xs text-isap-steel font-mono">
          Showing {articles.length} cleared publication(s)
        </span>
      </div>

      {articles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {articles.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      ) : (
        <div class="p-12 text-center bg-white rounded-2xl border border-isap-border max-w-md mx-auto space-y-2">
          <p class="text-sm font-semibold text-isap-navy">No Published Articles</p>
          <p class="text-xs text-isap-steel">Draft releases are undergoing editorial review.</p>
        </div>
      )}

    </div>
  </section>
</Layout>
