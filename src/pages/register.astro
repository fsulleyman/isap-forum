---
import Layout from '@/layouts/Layout.astro';
import PageBanner from '@/components/banners/PageBanner.astro';
import { getRegisterPage, getEventFacts } from '@/lib/sanity/client';

const registerPage = await getRegisterPage();
const eventFacts = await getEventFacts();
---

<Layout
  title={`${registerPage.bannerTitle} — ISAP Forum 2026`}
  description={registerPage.bannerSubtitle}
>
  <PageBanner
    title={registerPage.bannerTitle}
    subtitle={registerPage.bannerSubtitle}
    bannerImage={registerPage.bannerImage}
    badge="Delegate Accreditation"
    breadcrumbs={[{ label: 'Register' }]}
  />

  <section class="py-16 md:py-24 bg-isap-off-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      
      <!-- Event Information Recap Header -->
      <div class="bg-white rounded-2xl border border-isap-border/70 p-8 sm:p-10 shadow-sm space-y-8">
        
        <!-- Intro Notice -->
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-isap-navy/5 text-isap-navy text-xs font-semibold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-isap-gold"></span>
            <span>Accreditation Guidelines</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold font-heading text-isap-navy">
            Official Delegate Registration Portal
          </h2>
          <p class="text-base text-isap-gray-dark leading-relaxed">
            {registerPage.introCopy}
          </p>
        </div>

        <!-- Event Facts Recap Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 rounded-xl bg-isap-navy text-white text-sm">
          <div class="space-y-1">
            <span class="text-xs text-isap-steel uppercase font-medium">Conference Date</span>
            <p class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-isap-gold"></span>
              <span>{eventFacts.date}</span>
            </p>
          </div>
          <div class="space-y-1">
            <span class="text-xs text-isap-steel uppercase font-medium">Conference Venue</span>
            <p class="text-sm font-semibold text-white/95">
              {eventFacts.venue}
            </p>
          </div>
          <div class="sm:col-span-2 space-y-1 pt-2 border-t border-white/10">
            <span class="text-xs text-isap-steel uppercase font-medium">Host Institution</span>
            <p class="text-xs text-white/85">
              {eventFacts.hostInstitution}
            </p>
          </div>
        </div>

        <!-- QR Code & Direct Registration Portal Block -->
        <div class="border-t border-isap-border/60 pt-8 flex flex-col md:flex-row items-center gap-8 justify-between">
          
          <!-- Official QR Code Image Container -->
          <div class="flex flex-col items-center text-center space-y-3 shrink-0">
            <div class="p-3 bg-white border-2 border-isap-navy rounded-2xl shadow-md">
              <img
                src={registerPage.qrCodeImage?.asset?.url || (typeof registerPage.qrCodeImage === 'string' ? registerPage.qrCodeImage : '/isap-qr.jpg')}
                alt={registerPage.qrCodeAlt || "ISAP Forum 2026 Registration QR Code"}
                class="w-48 h-48 sm:w-56 sm:h-56 object-contain"
                width="224"
                height="224"
              />
            </div>
            <span class="text-xs font-bold text-isap-navy uppercase tracking-wider flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-isap-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
              <span>Scan to Register</span>
            </span>
            <span class="text-[11px] text-isap-steel max-w-[200px] leading-tight">
              Point your smartphone camera to open the official registration form
            </span>
          </div>

          <!-- Action & Direct Google Form Link -->
          <div class="space-y-6 flex-grow text-center md:text-left">
            <div class="space-y-2">
              <h3 class="text-xl font-bold font-heading text-isap-navy">
                Online Registration via Google Forms
              </h3>
              <p class="text-sm text-isap-gray-dark/85 leading-relaxed">
                Click below to open the official Google Form in a new tab and submit your delegate details directly to the secretariat.
              </p>
            </div>

            <div class="space-y-3">
              <!-- Primary Register CTA -->
              <a
                href={registerPage.googleFormUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-8 py-4 rounded-md bg-isap-gold hover:bg-[#b88616] text-isap-navy-dark font-bold text-base shadow-lg hover:shadow-xl transition-all duration-150 transform hover:-translate-y-0.5 active:translate-y-0"
              >
                <span>Register Now (Google Form)</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
              </a>

              <!-- Fallback Visible URL -->
              <div class="pt-2">
                <span class="text-xs text-isap-steel block mb-1">Direct link fallback:</span>
                <a
                  href={registerPage.googleFormUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs sm:text-sm text-isap-navy hover:text-isap-gold underline font-mono break-all"
                >
                  {registerPage.googleFormUrl}
                </a>
              </div>
            </div>

            <!-- Disclaimer Notice -->
            <div class="p-4 rounded-lg bg-isap-off-white border border-isap-border/60 text-xs text-isap-gray-dark/90 leading-relaxed">
              <span class="font-bold text-isap-navy block mb-0.5">Important:</span>
              {registerPage.registrationDisclaimer}
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>
