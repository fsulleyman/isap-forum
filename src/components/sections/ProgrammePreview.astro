---
import SectionHeading from './SectionHeading.astro';
import type { ProgrammeSession } from '@/types/sanity';
import { resolvePath } from '@/lib/paths';

interface Props {
  sessions: ProgrammeSession[];
}

const { sessions } = Astro.props;
// Preview the first 5 sessions
const previewSessions = sessions.slice(0, 5);
---

<section class="py-16 md:py-24 bg-white border-b border-isap-border/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <SectionHeading
        eyebrow="Forum Agenda Preview"
        title="Conference Programme Overview"
        description="A full-day academic and practitioner agenda on Wednesday, 7 October 2026 at the UPSA PCU Auditorium."
      />
      <div class="shrink-0 mb-10 md:mb-14">
        <a
          href={resolvePath('/programme')}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-isap-navy hover:bg-isap-navy-light text-white font-semibold text-sm transition-colors"
        >
          <span>View Complete Programme</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-isap-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Timeline / Stacked Cards Preview -->
    <div class="space-y-4 max-w-4xl mx-auto">
      {previewSessions.map((session, index) => {
        const isTBA = session.status === 'TBA';
        return (
          <div class="bg-isap-off-white border border-isap-border/60 rounded-xl p-5 sm:p-6 hover:border-isap-navy/40 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-1.5 flex-grow">
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-isap-navy text-white">
                  {session.time}
                </span>
                {isTBA ? (
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-500/10 text-amber-700 border border-amber-500/30">
                    To Be Announced
                  </span>
                ) : (
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-green-500/10 text-green-700 border border-green-500/30">
                    Confirmed
                  </span>
                )}
              </div>
              <h4 class="text-base sm:text-lg font-bold font-heading text-isap-navy">
                {session.session}
              </h4>
              {session.topic && (
                <p class="text-xs sm:text-sm text-isap-gray-dark/90 leading-relaxed">
                  {session.topic}
                </p>
              )}
            </div>

            <div class="shrink-0 text-left sm:text-right border-t sm:border-t-0 pt-2 sm:pt-0 border-isap-border/40">
              <span class="text-xs text-isap-steel block">Host / Organiser</span>
              <span class="text-xs font-semibold text-isap-navy block">
                {session.organisation || 'ISAP Secretariat'}
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-8 text-center">
      <p class="text-xs text-isap-steel">
        Schedule subject to ceremonial and keynote confirmations. Unconfirmed speaker slots strictly displayed as TBA.
      </p>
    </div>

  </div>
</section>
