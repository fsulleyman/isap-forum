---
import SectionHeading from './SectionHeading.astro';
import type { PillarCard } from '@/types/sanity';

interface Props {
  aboutBlurb: string;
  cards: PillarCard[];
}

const { aboutBlurb, cards } = Astro.props;
---

<section class="py-16 md:py-24 bg-isap-off-white border-b border-isap-border/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- About Blurb Banner -->
    <div class="max-w-4xl mx-auto mb-16 p-8 rounded-2xl bg-white border border-isap-border/60 shadow-sm relative overflow-hidden">
      <div class="absolute top-0 left-0 w-2 h-full bg-isap-gold"></div>
      <div class="space-y-3 pl-2">
        <span class="text-xs font-bold uppercase tracking-wider text-isap-navy">
          Forum Origin & Purpose
        </span>
        <h3 class="text-xl sm:text-2xl font-bold font-heading text-isap-navy">
          Bridging the Academic-Practitioner Divide
        </h3>
        <p class="text-base sm:text-lg text-isap-gray-dark leading-relaxed">
          {aboutBlurb}
        </p>
      </div>
    </div>

    <!-- Section Heading -->
    <SectionHeading
      eyebrow="Core Rationale"
      title="Why This Forum Matters"
      description="Four foundational pillars underpinning our mission to drive evidence-based Information Systems impact."
      align="center"
    />

    <!-- 4 Pillar Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {cards.map((card, index) => (
        <div class="bg-white rounded-xl p-6 sm:p-7 border border-isap-border/60 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group hover:border-isap-gold/50">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-isap-navy px-2.5 py-1 rounded bg-isap-navy/5">
                0{index + 1}
              </span>
              {card.badge && (
                <span class="text-[11px] font-semibold text-isap-navy-light bg-isap-gold/15 px-2 py-0.5 rounded-full border border-isap-gold/30">
                  {card.badge}
                </span>
              )}
            </div>

            <h3 class="text-lg font-bold font-heading text-isap-navy group-hover:text-[#111A3A] transition-colors">
              {card.title}
            </h3>

            <p class="text-sm text-isap-gray-dark/85 leading-relaxed">
              {card.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-isap-border/30">
            <span class="text-xs font-semibold text-isap-navy flex items-center gap-1 group-hover:gap-1.5 transition-all">
              <span>Learn in Section</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-isap-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
