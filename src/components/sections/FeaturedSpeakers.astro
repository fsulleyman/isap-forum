---
import SectionHeading from './SectionHeading.astro';
import SpeakerCard from '@/components/cards/SpeakerCard.astro';
import type { Speaker } from '@/types/sanity';
import { resolvePath } from '@/lib/paths';

interface Props {
  speakers: Speaker[];
}

const { speakers } = Astro.props;
// Strict query-layer status filter verification: only Published
const publishedSpeakers = speakers.filter((s) => s.status === 'Published');
---

<section class="py-16 md:py-24 bg-isap-off-white border-b border-isap-border/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <SectionHeading
        eyebrow="Thought Leadership"
        title="Distinguished Speakers & Panelists"
        description="Leading Information Systems academics, identity infrastructure architects, and public policy leaders."
      />
      <div class="shrink-0 mb-10 md:mb-14">
        <a
          href={resolvePath('/speakers')}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-isap-navy hover:bg-isap-navy-light text-white font-semibold text-sm transition-colors"
        >
          <span>All Speakers & Bios</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-isap-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    {publishedSpeakers.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {publishedSpeakers.slice(0, 3).map((speaker) => (
          <SpeakerCard speaker={speaker} />
        ))}
      </div>
    ) : (
      <div class="max-w-xl mx-auto text-center p-8 bg-white border border-isap-border/60 rounded-xl space-y-3">
        <div class="w-12 h-12 rounded-full bg-isap-navy/5 text-isap-navy mx-auto flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <h4 class="text-lg font-bold font-heading text-isap-navy">Speaker Announcements in Progress</h4>
        <p class="text-sm text-isap-steel">
          Keynote dignitaries and session panelists are being confirmed by the organizing committee. Official announcements will be published shortly.
        </p>
      </div>
    )}

  </div>
</section>
