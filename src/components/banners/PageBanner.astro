---
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  breadcrumbs?: Crumb[];
  badge?: string;
}

const {
  title,
  subtitle,
  backgroundImage = '/banner-default.jpg',
  breadcrumbs = [],
  badge,
} = Astro.props;
---

<section 
  class="relative w-full overflow-hidden bg-isap-navy-dark text-white border-b border-isap-border/10"
  aria-label={title}
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={backgroundImage} 
      alt="" 
      aria-hidden="true" 
      class="w-full h-full object-cover object-center opacity-30 mix-blend-luminosity filter saturate-50" 
      loading="eager"
    />
    <!-- Rich Navy Gradients -->
    <div class="absolute inset-0 bg-gradient-to-r from-isap-navy-dark via-isap-navy/95 to-isap-navy-light/80"></div>
    <div class="absolute inset-0 bg-radial-at-t from-transparent via-isap-navy-dark/40 to-isap-navy-dark/90"></div>
  </div>

  <!-- Decorative Architectural Grid Lines -->
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px]"></div>

  <!-- Content Container -->
  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28 min-h-[300px] md:min-h-[380px] lg:min-h-[420px] flex flex-col justify-end">
    <div class="max-w-4xl">
      <!-- Breadcrumb Navigation -->
      {breadcrumbs.length > 0 && (
        <div class="mb-4 md:mb-6">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )}

      <!-- Optional Eyebrow / Category Badge -->
      {badge && (
        <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-isap-gold/15 border border-isap-gold/30 text-isap-gold text-xs font-semibold tracking-wider uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-isap-gold animate-pulse"></span>
          <span>{badge}</span>
        </div>
      )}

      <!-- Main Banner Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-bold font-heading text-white tracking-tight leading-tight">
        {title}
      </h1>

      <!-- Gold Accent Rule -->
      <div class="w-20 h-1.5 bg-isap-gold mt-4 mb-4 rounded-full"></div>

      <!-- Subtitle -->
      {subtitle && (
        <p class="text-base sm:text-lg md:text-xl text-isap-steel/90 font-normal leading-relaxed max-w-3xl">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
