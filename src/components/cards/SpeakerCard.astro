---
import type { Speaker } from '@/types/sanity';

interface Props {
  speaker: Speaker;
}

const { speaker } = Astro.props;
const initials = speaker.name
  .split(' ')
  .filter((_, i, arr) => i === 0 || i === arr.length - 1)
  .map((n) => n[0])
  .join('');
---

<div class="bg-white rounded-xl border border-isap-border/70 overflow-hidden shadow-sm hover:shadow-md hover:border-isap-gold/50 transition-all flex flex-col justify-between group">
  <div>
    <!-- Speaker Portrait / Avatar Header -->
    <div class="relative h-48 sm:h-52 bg-gradient-to-br from-isap-navy-dark to-isap-navy flex items-center justify-center overflow-hidden">
      {speaker.photoUrl ? (
        <img
          src={speaker.photoUrl}
          alt={`Portrait of ${speaker.name}`}
          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      ) : (
        <!-- Professional Institutional Monogram Placeholder -->
        <div class="flex flex-col items-center justify-center text-center p-4">
          <div class="w-20 h-20 rounded-full bg-white/10 border-2 border-isap-gold/40 flex items-center justify-center text-isap-gold text-2xl font-bold font-heading mb-2">
            {initials}
          </div>
          <span class="text-[11px] text-isap-steel uppercase tracking-widest font-mono">
            Speaker Profile
          </span>
        </div>
      )}
      
      <!-- Role Badge Overlay -->
      {speaker.role && (
        <div class="absolute bottom-3 left-3 right-3">
          <span class="inline-block px-2.5 py-1 rounded bg-isap-navy-dark/90 backdrop-blur-sm border border-white/15 text-isap-gold text-xs font-semibold tracking-wide shadow">
            {speaker.role}
          </span>
        </div>
      )}
    </div>

    <!-- Speaker Details -->
    <div class="p-5 sm:p-6 space-y-3">
      <div>
        <h3 class="text-lg sm:text-xl font-bold font-heading text-isap-navy group-hover:text-isap-navy-light transition-colors">
          {speaker.name}
        </h3>
        {speaker.title && (
          <p class="text-xs sm:text-sm font-medium text-isap-steel/90 mt-0.5">
            {speaker.title}
          </p>
        )}
      </div>

      <p class="text-xs font-semibold text-isap-navy/80 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-isap-gold shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
        <span>{speaker.organisation}</span>
      </p>

      {speaker.bio && (
        <p class="text-xs text-isap-gray-dark/85 line-clamp-3 leading-relaxed pt-1">
          {speaker.bio}
        </p>
      )}
    </div>
  </div>

  <!-- Card Footer: LinkedIn -->
  <div class="px-5 sm:px-6 pb-5 pt-3 border-t border-isap-border/30 flex items-center justify-between text-xs">
    <span class="text-[11px] text-isap-steel font-medium">ISAP Forum 2026</span>
    {speaker.linkedin ? (
      <a
        href={speaker.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-isap-navy hover:text-[#0A66C2] font-semibold transition-colors"
        aria-label={`${speaker.name} on LinkedIn`}
      >
        <span>LinkedIn</span>
        <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28"/></svg>
      </a>
    ) : (
      <span class="text-isap-steel/60">Faculty Delegate</span>
    )}
  </div>
</div>
