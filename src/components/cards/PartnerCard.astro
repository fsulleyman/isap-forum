---
import type { Institution } from '@/types/sanity';

interface Props {
  institution: Institution;
}

const { institution } = Astro.props;

const categoryBadges: Record<string, { bg: string; text: string; border: string }> = {
  Sponsor: { bg: 'bg-amber-50', text: 'text-amber-800', border: 'border-amber-300' },
  Partner: { bg: 'bg-blue-50', text: 'text-blue-800', border: 'border-blue-300' },
  Supporting: { bg: 'bg-emerald-50', text: 'text-emerald-800', border: 'border-emerald-300' },
  Participating: { bg: 'bg-purple-50', text: 'text-purple-800', border: 'border-purple-300' },
};

const badge = categoryBadges[institution.category] || { bg: 'bg-gray-50', text: 'text-gray-800', border: 'border-gray-300' };
---

<div class="bg-white rounded-xl border border-isap-border/70 p-6 shadow-sm hover:shadow-md hover:border-isap-gold/50 transition-all flex flex-col justify-between group">
  <div class="space-y-4">
    <!-- Header with Category Badge -->
    <div class="flex items-center justify-between">
      <span class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold border uppercase tracking-wider ${badge.bg} ${badge.text} ${badge.border}`}>
        {institution.category}
      </span>
      <div class="w-2 h-2 rounded-full bg-isap-navy/20"></div>
    </div>

    <!-- Institution Name -->
    <h3 class="text-base sm:text-lg font-bold font-heading text-isap-navy group-hover:text-isap-navy-light transition-colors leading-snug">
      {institution.name}
    </h3>

    {institution.description && (
      <p class="text-xs sm:text-sm text-isap-gray-dark/85 leading-relaxed">
        {institution.description}
      </p>
    )}
  </div>

  <!-- Website Link -->
  <div class="mt-6 pt-4 border-t border-isap-border/40 flex items-center justify-between">
    <span class="text-[11px] text-isap-steel">Verified Institutional Affiliate</span>
    {institution.website && (
      <a
        href={institution.website}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs font-semibold text-isap-navy hover:text-isap-gold transition-colors"
      >
        <span>Visit Site</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
      </a>
    )}
  </div>
</div>
