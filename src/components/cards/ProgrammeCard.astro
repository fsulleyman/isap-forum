---
import type { ProgrammeSession } from '@/types/sanity';

interface Props {
  session: ProgrammeSession;
}

const { session } = Astro.props;
const isTBA = session.status === 'TBA';
const speakerDisplay = session.speaker?.name || session.speakerName || (isTBA ? 'TBA' : 'ISAP Faculty Conveners');
---

<div class={`p-6 rounded-xl border transition-all ${
  isTBA 
    ? 'bg-white border-isap-border/60 border-l-4 border-l-amber-500' 
    : 'bg-white border-isap-border/70 border-l-4 border-l-isap-navy hover:border-isap-gold/50 shadow-sm hover:shadow-md'
}`}>
  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
    
    <!-- Time & Session Metadata Column -->
    <div class="space-y-2 flex-grow">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="px-3 py-1 rounded text-xs font-mono font-bold bg-isap-navy text-white tracking-wide">
          {session.time}
        </span>
        {isTBA ? (
          <span class="px-2.5 py-0.5 rounded text-[11px] font-semibold bg-amber-500/15 text-amber-800 border border-amber-500/30">
            To Be Announced
          </span>
        ) : (
          <span class="px-2.5 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/15 text-emerald-800 border border-emerald-500/30">
            Confirmed Slot
          </span>
        )}
      </div>

      <h3 class="text-lg sm:text-xl font-bold font-heading text-isap-navy leading-snug">
        {session.session}
      </h3>

      {session.topic && (
        <p class="text-sm text-isap-gray-dark/90 leading-relaxed max-w-3xl">
          <span class="font-semibold text-isap-navy/80">Topic: </span>
          {session.topic}
        </p>
      )}
    </div>

    <!-- Speaker & Moderator Column -->
    <div class="shrink-0 md:text-right border-t md:border-t-0 pt-3 md:pt-0 border-isap-border/30 space-y-2 min-w-[220px]">
      <div>
        <span class="text-[11px] text-isap-steel uppercase font-semibold block">Key Speaker / Lead</span>
        <span class={`text-sm font-bold block leading-tight ${isTBA ? 'text-amber-700 italic' : 'text-isap-navy'}`}>
          {speakerDisplay}
        </span>
      </div>

      {session.moderator && (
        <div>
          <span class="text-[11px] text-isap-steel uppercase font-semibold block">Session Moderator</span>
          <span class="text-xs text-isap-gray-dark block leading-tight">
            {session.moderator}
          </span>
        </div>
      )}

      {session.organisation && (
        <div class="text-xs text-isap-steel/90 pt-1">
          <span>{session.organisation}</span>
        </div>
      )}
    </div>

  </div>
</div>
