---
import type { Resource } from '@/types/sanity';

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const isBefore = resource.category === 'Before Event';
---

<div class="bg-white rounded-xl border border-isap-border/70 p-6 shadow-sm hover:shadow-md hover:border-isap-gold/50 transition-all flex flex-col justify-between group">
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <span class={`inline-block px-2.5 py-0.5 rounded text-[11px] font-bold border uppercase tracking-wider ${
        isBefore 
          ? 'bg-blue-50 text-blue-800 border-blue-200' 
          : 'bg-emerald-50 text-emerald-800 border-emerald-200'
      }`}>
        {resource.category}
      </span>
      <span class="text-xs text-isap-steel font-mono">{resource.date}</span>
    </div>

    <h3 class="text-base sm:text-lg font-bold font-heading text-isap-navy group-hover:text-isap-navy-light transition-colors leading-snug">
      {resource.title}
    </h3>

    <p class="text-xs sm:text-sm text-isap-gray-dark/85 leading-relaxed">
      {resource.description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-isap-border/40 flex items-center justify-between">
    <span class="text-[11px] text-isap-steel">Official Document</span>
    <a
      href={resource.fileOrUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-xs font-bold text-isap-navy hover:text-isap-gold transition-colors"
    >
      <span>Access Document</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
    </a>
  </div>
</div>
