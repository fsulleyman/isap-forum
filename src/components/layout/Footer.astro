---
import { getSiteSettings, getEventFacts } from '@/lib/sanity/client';

const siteSettings = await getSiteSettings();
const eventFacts = await getEventFacts();
---

<footer class="bg-isap-navy-dark text-white border-t border-white/10" role="contentinfo">
  <!-- Top Accent Stripe -->
  <div class="h-1.5 w-full bg-gradient-to-r from-isap-navy via-isap-gold to-isap-navy"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- Institutional Identity Column -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-lg bg-white p-1 shrink-0 shadow-sm border border-isap-gold/40">
            <img 
              src="/isap-logo.jpg" 
              alt="ISAP Forum Logo" 
              class="w-full h-full object-contain"
              width="48"
              height="48"
            />
          </div>
          <div>
            <span class="font-heading font-bold text-xl text-white block leading-tight">
              ISAP <span class="text-isap-gold">Forum</span>
            </span>
            <span class="text-xs text-isap-steel block leading-tight">
              {eventFacts.orgFullName}
            </span>
          </div>
        </div>

        <p class="text-sm text-isap-steel/90 leading-relaxed max-w-md">
          {siteSettings.footerOrgText}
        </p>

        <!-- Institutional Hierarchy Attribution -->
        <div class="pt-2 text-xs text-isap-steel/80 space-y-1 border-t border-white/5 max-w-md">
          <p class="font-semibold text-white/90">Host Institution:</p>
          <p>{siteSettings.hostDepartment}</p>
          <p>{siteSettings.hostFaculty}</p>
          <p class="text-isap-gold font-medium">{siteSettings.hostUniversity}</p>
        </div>
      </div>

      <!-- Quick Links Column -->
      <div class="lg:col-span-4 space-y-4">
        <h3 class="font-heading font-semibold text-base text-white uppercase tracking-wider text-xs text-isap-gold">
          Forum Navigation
        </h3>
        <ul class="grid grid-cols-2 gap-2 text-sm">
          <li><a href="/about" class="text-isap-steel/90 hover:text-isap-gold transition-colors">About ISAP</a></li>
          <li><a href="/forum-2026" class="text-isap-steel/90 hover:text-isap-gold transition-colors">ISAP Forum 2026</a></li>
          <li><a href="/programme" class="text-isap-steel/90 hover:text-isap-gold transition-colors">Programme</a></li>
          <li><a href="/speakers" class="text-isap-steel/90 hover:text-isap-gold transition-colors">Speakers & Panel</a></li>
          <li><a href="/partners" class="text-isap-steel/90 hover:text-isap-gold transition-colors">Partners</a></li>
          <li><a href="/news" class="text-isap-steel/90 hover:text-isap-gold transition-colors">News & Updates</a></li>
          <li><a href="/resources" class="text-isap-steel/90 hover:text-isap-gold transition-colors">Resources</a></li>
          <li><a href="/register" class="text-isap-gold font-medium hover:underline">Register (Oct 7)</a></li>
          <li><a href="/contact" class="text-isap-steel/90 hover:text-isap-gold transition-colors">Contact</a></li>
        </ul>

        <!-- Event Quick Fact Badge -->
        <div class="mt-4 p-3.5 rounded-lg bg-white/5 border border-white/10 space-y-1">
          <div class="text-xs font-semibold text-isap-gold uppercase tracking-wider flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            <span>Conference Fact Sheet</span>
          </div>
          <p class="text-xs font-medium text-white">{eventFacts.date}</p>
          <p class="text-[11px] text-isap-steel">{eventFacts.venue}</p>
        </div>
      </div>

      <!-- Connect & Compliance Column -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="font-heading font-semibold text-base text-white uppercase tracking-wider text-xs text-isap-gold">
          Official Connect
        </h3>
        <p class="text-xs text-isap-steel/90 leading-relaxed">
          Follow the official ISAP Forum network for live speaker updates, session recordings, and post-conference proceedings.
        </p>

        <!-- Official LinkedIn Button -->
        <a 
          href={siteSettings.linkedinUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-md bg-[#0A66C2] hover:bg-[#084e96] text-white font-medium text-xs tracking-wide shadow-sm transition-all"
          aria-label="Connect on ISAP Forum LinkedIn Profile"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28"/>
          </svg>
          <span>Connect on LinkedIn</span>
        </a>

        <div class="pt-2">
          <a href="/register" class="block text-center py-2 px-3 rounded bg-isap-gold text-isap-navy-dark font-bold text-xs hover:brightness-105 transition-all">
            Online Registration Portal &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Line -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-isap-steel/70 gap-4">
      <p>{siteSettings.copyrightNotice}</p>
      <div class="flex items-center gap-4">
        <span class="hover:text-isap-steel transition-colors">Accra, Ghana</span>
        <span>•</span>
        <a href="/contact" class="hover:text-isap-gold transition-colors">Organizing Secretariat</a>
      </div>
    </div>
  </div>
</footer>
