---
import { MainNav } from '@/components/navigation/MainNav';
import { MobileNav } from '@/components/navigation/MobileNav';
import { getSiteSettings } from '@/lib/sanity/client';

const siteSettings = await getSiteSettings();
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full bg-isap-navy border-b border-white/10 shadow-md backdrop-blur-md bg-opacity-95">
  <!-- Skip Link for Keyboard Accessibility -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-isap-gold focus:text-isap-navy-dark focus:font-bold focus:shadow-lg focus:rounded"
  >
    Skip to main content
  </a>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[72px] lg:h-[80px]">
      <!-- Brand Logo -->
      <a 
        href="/" 
        class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-isap-gold rounded-lg p-1"
        aria-label="ISAP Forum - Home"
      >
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-lg overflow-hidden bg-white p-0.5 shadow-sm shrink-0 border border-isap-gold/30">
          <img 
            src="/isap-logo.jpg" 
            alt="ISAP Forum Logo" 
            class="w-full h-full object-contain"
            width="44"
            height="44"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-lg sm:text-xl text-white tracking-tight leading-none group-hover:text-isap-gold transition-colors">
            ISAP <span class="text-isap-gold">Forum</span>
          </span>
          <span class="text-[10px] sm:text-[11px] text-isap-steel/90 tracking-wide uppercase font-medium leading-tight mt-0.5 hidden sm:block">
            Academics & Practitioners
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <MainNav currentPath={currentPath} items={siteSettings.navItems} client:load />

      <!-- Header Actions: Gold Register Button + Mobile Hamburger -->
      <div class="flex items-center gap-3">
        <!-- Prominent Gold Register CTA (Always visible on mobile & desktop) -->
        <a
          href="/register"
          class="inline-flex items-center justify-center px-4 py-2 sm:px-5 sm:py-2.5 rounded-md bg-isap-gold hover:bg-[#b88616] text-isap-navy-dark font-bold text-xs sm:text-sm tracking-wide shadow-sm hover:shadow transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-isap-navy"
        >
          <span>Register</span>
          <span class="hidden sm:inline">&nbsp;Now</span>
        </a>

        <!-- Mobile Drawer Toggle -->
        <MobileNav currentPath={currentPath} items={siteSettings.navItems} client:visible />
      </div>
    </div>
  </div>
</header>
